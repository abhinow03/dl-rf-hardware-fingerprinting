# code only in git — artifacts, checkpoints, data caches excluded
__pycache__/
*.py[cod]
*.pt
*.pth
*.npz
*.npy
*.pkl
*.log
# experiment artifacts (frozen main + new gen_rff branch)
runs/
results/
runs_gen/
results_gen/
demo/out/
*.jsonl
.ipynb_checkpoints/
# ext-protocols: raw datasets + audit outputs never enter git (only the .md verdicts do)
gen_rff/ext_protocols/data_raw/
gen_rff/ext_protocols/audit_out/
!gen_rff/ext_protocols/audit_out/
!gen_rff/ext_protocols/audit_out/*.md
